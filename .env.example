PORT=3000
NODE_ENV=development

# Supabase. The service-role key stays on the server; never put it in a browser or a chat.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The public key. Used only to check staff passwords for the lead board.
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SCHEMA=public
PROPERTIES_TABLE=properties

# Telegram bot (create it with @BotFather)
TELEGRAM_BOT_TOKEN=
# Any long random string: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# "polling" on a laptop, "webhook" on a server. Defaults to polling unless NODE_ENV=production.
TELEGRAM_MODE=
# The public https address of this service (webhook mode). Railway's domain is picked up automatically.
PUBLIC_BASE_URL=
# Chat that receives site visit alerts. Your own Telegram user id works for a demo.
SALES_DESK_CHAT_ID=
BUSINESS_HOURS=Mon to Sat, 10am to 7pm IST
# What the assistant says when it does not have a detail. Only keep it if it is true for your team.
TEAM_CONFIRM_LINE=Our team can confirm it at a site visit.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# minimal is fastest; low, medium and high think longer
OPENAI_REASONING_EFFORT=minimal
# How long one customer turn may take, in milliseconds
AGENT_TIMEOUT_MS=25000

# Lead board: who may read actual conversations. test = test leads only, all = everyone, none = nobody.
BOARD_SHOW_CONVERSATIONS=test

# HTTP tool routes for chat agents that call this service over the web (the WhatsApp setup).
# Off by default in production. If you turn them on, CONNECTOR_BEARER_TOKEN is required.
ENABLE_TOOL_ROUTES=
CONNECTOR_BEARER_TOKEN=
