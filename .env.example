PORT=3000
NODE_ENV=development

# Required for live Supabase-backed searches.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. If set, callers must send Authorization: Bearer <token>.
CONNECTOR_BEARER_TOKEN=

# Optional schema/table overrides.
SUPABASE_SCHEMA=public
PROPERTIES_TABLE=properties

# Optional CSV column list used for broad text searches.
SEARCH_COLUMNS=title,location,category,status,raw_listing_text

# Optional. Leave empty if your table has no timestamp/sort column.
ORDER_COLUMN=created_at
